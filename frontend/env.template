# 前端 API 基础 URL 配置模板
# 
# 使用方法：
# 1. 将此文件复制为 .env
# 2. 修改下面的配置为你的实际域名
# 
# cp env.template .env
# 
# 然后编辑 .env 文件，将 localhost 替换为你的域名

# 使用 HTTPS（推荐生产环境）:
# VITE_API_BASE_URL=https://yourdomain.com/api/v1

# 使用 HTTP（开发环境）:
# VITE_API_BASE_URL=http://yourdomain.com:8000/api/v1

# 本地开发（默认）:
VITE_API_BASE_URL=http://localhost:8000/api/v1


# ========================
# ChatBI .gitignore
# ========================

# --- Environment variables (contains secrets) ---
.env
.env.local
.env.*.local

# --- OS files ---
.DS_Store
Thumbs.db

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- Runtime data (generated at runtime, not source code) ---
data/
logs/
*.log

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
*.egg
.mypy_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
.cache/

# --- Database files ---
*.db
*.sqlite3

# --- Node ---
node_modules/
dist/
dist-ssr/

# --- Build artifacts ---
*.local

# --- Docker ---
docker-compose.override.yml

# --- Models (large binary files, download at runtime) ---
backend/models/

# --- Large font files (download separately) ---
g2-ssr/Arial_Unicode.ttf
g2-ssr/node_modules/

# --- Auto-generated type declarations ---
frontend/auto-imports.d.ts
frontend/components.d.ts
frontend/.eslintrc-auto-import.json

# --- Thesis and references (academic files, not part of source code) ---
毕设论文（终极版）.md
参考文献/
backend/tests/

# --- Performance/thesis test scripts (not part of source code) ---
backend/scripts/perf_*
backend/scripts/test_*
backend/scripts/thesis_*
backend/scripts/defense_test.py
backend/scripts/random_stress_test.py
backend/scripts/final_perf.py
backend/scripts/perf_avg3.py
backend/scripts/thesis_perf_output.txt
backend/perf_result.txt
backend/test_table52.py
backend/test_table52_v2.py
